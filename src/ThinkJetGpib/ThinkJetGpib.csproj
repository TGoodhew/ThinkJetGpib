<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ThinkJetGpib: installer, uninstaller and print bridge service in one exe.

    32-bit (win-x86) to match the 32-bit NI-VISA stack GPIB-MCP uses; it calls visa32.dll directly,
    so there is no VISA.NET reference. Published self-contained and single-file, so the target PC
    needs only NI-VISA, not a .NET runtime.

      dotnet publish src\ThinkJetGpib -c Release -o dist
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ThinkJetGpibSetup</AssemblyName>
    <RootNamespace>ThinkJetGpib</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>ThinkJetGpib</Product>
    <Authors>Tony Goodhew</Authors>
    <Copyright>Copyright (c) 2026 Tony Goodhew. MIT License.</Copyright>
    <RepositoryUrl>https://github.com/TGoodhew/ThinkJetGpib</RepositoryUrl>
    <Description>HP 2225 ThinkJet GPIB printer driver installer and print bridge</Description>

    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

  <!-- The installer's payload: extracted to Program Files at install time. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\driver\TJ2225.inf" LogicalName="payload/driver/TJ2225.inf" />
    <EmbeddedResource Include="..\..\driver\TJ2225.gpd" LogicalName="payload/driver/TJ2225.gpd" />
    <EmbeddedResource Include="Scripts\install.ps1" LogicalName="payload/scripts/install.ps1" />
    <EmbeddedResource Include="Scripts\uninstall.ps1" LogicalName="payload/scripts/uninstall.ps1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ThinkJetGpib.Tests" />
  </ItemGroup>

</Project>
